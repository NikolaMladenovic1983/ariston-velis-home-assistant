# Copy to ha-config/secrets.yaml and fill in. secrets.yaml is never committed.

# Notify action used by all boiler notifications (Settings → Companion app shows the device name;
# the action is notify.mobile_app_<device_name>).
bojler_notify: notify.mobile_app_your_phone

# Only if you use ha-config/packages/bojler_google.yaml (Google Home): your Google Cloud project ID.
google_project_id: your-google-project-id
